
<%- include("partials/header"); -%>

    <h1>Update My Journal</h1>
    <form class="" action="/edit/<%= post._id %>" method="post">
      <div class="form-group">
        <label>Title</label>
        <input class="form-control" value="<%= post.title %>" type="text" name="postTitle" >
        <label>Post</label>
        <textarea class="form-control" name="postBody" rows="5" cols="30"><%= post.content %></textarea>
      </div>
      <button class="btn btn-primary" type="submit" name="button">Update</button>
    </form>

<%- include("partials/footer"); -%>
